{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "typeRoots": [
      "node_modules/@types",
      "src/types"
    ]
  },
  "include": ["src"],
  "exclude": [
    "src/proto",
    "src/layout/OnlinePlayLayout",
    "src/pages/OnlinePlay",
    "src/pages/OnlinePlayRoom",
    "src/types/proto.d.ts",
    "src/utils/proto.ts",
    "src/ws"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
